# Copy this file to .env and adjust as needed. `.env` is gitignored — never commit real values here.
# `npm run dev` requires .env to exist (even empty) since it's loaded via Node's --env-file flag.

# "claude-code" spawns the real Claude Code CLI headlessly against each Mission's worktree
# (src/provider-adapter/claudeCodeAdapter.ts). Anything else (including unset) uses the
# mock adapter — instant, makes no code changes. See docs/03-ARCHITECTURE.md §6.
AGENTSPACE_PROVIDER=mock

# Express port. Defaults to 4310 if unset.
# PORT=4310

# Where the SQLite store lives. Defaults to ./data if unset.
# AGENTSPACE_DATA_DIR=./data

# Where Execution Engine creates git worktrees. Defaults to ./worktrees if unset.
# AGENTSPACE_WORKTREE_DIR=./worktrees

# Max autonomous `iterate` Executions per Mission before forcing a human check-in. Defaults to 3.
# AGENTSPACE_ITERATE_CAP=3

# Interface to bind. Keep it on loopback: the API can run commands on this machine.
# HOST=127.0.0.1
