{
  "name": "agentspace",
  "version": "0.1.0",
  "description": "A visual workspace for supervising an AI software engineering team that works autonomously inside a local git repository.",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:web": "npm run dev --prefix web",
    "dev:all": "node scripts/dev-banner.mjs && concurrently -n server,web -c blue,magenta \"npm run dev\" \"npm run dev:web\"",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "build:web": "npm run build --prefix web",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "license": "MIT"
}
